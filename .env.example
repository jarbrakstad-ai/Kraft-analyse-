# ENTSO-E Transparency Platform API key.
# Register at https://transparency.entsoe.eu/ then request a Web API
# security token under "My Account Settings" -> "Web API Security Token".
ENTSOE_API_KEY=

# MET Norway Frost API client ID (weather observations).
# Register at https://frost.met.no/auth/requestCredentials.html — free,
# issued immediately, no approval wait.
MET_FROST_CLIENT_ID=

# Postgres/TimescaleDB connection string used by the ingest scripts.
# Matches the credentials in docker-compose.yml by default.
DATABASE_URL=postgresql://kraft:kraft@localhost:5432/kraft_analyse
